/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com; img-src 'self' data: https://apm-badges.herokuapp.com; font-src 'self' https://maxcdn.bootstrapcdn.com; connect-src 'self' https://nominatim.openstreetmap.org https://callook.info https://api.weather.gov https://api.websitecarbon.com https://cloudflareinsights.com; frame-src https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://embed.windy.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

/*.pdf
  x-robots-tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
